# Copy to .env for local dev. PRODUCTION: set real secrets via env / Vault,
# never commit .env. app/config.py fail-fasts in ENV=production on placeholders.
ENV=development
DEBUG=False

# Database (PostgreSQL). Dev-only password; override POSTGRES_PASSWORD in prod.
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword_dev_only_change_in_prod@localhost:5432/webhook_platform
# SQLite fallback for offline dev/test:
# DATABASE_URL=sqlite:///./webhooks.db

# Secrets — dev placeholders only. Generate prod values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=wh_dev_insecure_secret_key_change_in_production_1234567890
SIGNING_SECRET_ENCRYPTION_KEY=yFz8s0v81v3G-xG3hV48V7s9uY5pL0tM2wN4bQ6rE8A=
API_KEY_PEPPER=
METRICS_API_KEY=
DEMO_RECEIVER_ADMIN_TOKEN=

# Worker & Broker
REDIS_URL=redis://localhost:6379/0
USE_CELERY=False
ENABLE_INPROCESS_DISPATCHER=True

# SSRF Protection — secure-by-default (False). Set True ONLY for local demo receiver.
ALLOW_LOCAL_RECEIVERS=True
ALLOWED_RECEIVER_DOMAINS=
DNS_RESOLVE_TIMEOUT_SECONDS=3.0
RECOVERY_BATCH_SIZE=500

# Retries & Delays
MAX_DELIVERY_ATTEMPTS=5
USE_DEMO_RETRY_POLICY=True
HTTP_TIMEOUT_SECONDS=10.0
HTTP_CONNECT_TIMEOUT_SECONDS=3.0
LEASE_DURATION_SECONDS=30

# Data retention (days). Audit logs retained longer (compliance).
DATA_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
