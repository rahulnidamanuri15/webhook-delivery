# Application Environment
ENV=development
DEBUG=False

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/webhook_platform
# SQLite fallback for offline dev/test:
# DATABASE_URL=sqlite:///./webhooks.db

# Secret Keys
SECRET_KEY=wh_dev_insecure_secret_key_change_in_production_1234567890
# 32 url-safe base64-encoded bytes for Fernet encryption:
SIGNING_SECRET_ENCRYPTION_KEY=yFz8s0v81v3G-xG3hV48V7s9uY5pL0tM2wN4bQ6rE8A=

# Worker & Broker
REDIS_URL=redis://localhost:6379/0
USE_CELERY=True

# SSRF Protection
ALLOW_LOCAL_RECEIVERS=True
ALLOWED_RECEIVER_DOMAINS=

# Retries & Delays
MAX_DELIVERY_ATTEMPTS=5
USE_DEMO_RETRY_POLICY=True
HTTP_TIMEOUT_SECONDS=10.0
HTTP_CONNECT_TIMEOUT_SECONDS=3.0
LEASE_DURATION_SECONDS=30

# Data retention (days)
DATA_RETENTION_DAYS=90

# Metrics Auth
METRICS_API_KEY=
