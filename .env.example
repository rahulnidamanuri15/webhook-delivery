# Webhook Delivery — production env template for Oracle Cloud Always Free ARM VM.
# Copy to .env on the VM and fill every value. NEVER commit .env.
#   cp .env.example .env
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          # SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # SIGNING_SECRET_ENCRYPTION_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(32))"          # API_KEY_PEPPER / METRICS_API_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(24))"          # POSTGRES_PASSWORD / REDIS_PASSWORD

ENV=production
DEBUG=False

# --- Required prod secrets (compose.prod.yaml + app/config.py fail-fast) ---
SECRET_KEY=CHANGE_ME_min_32_chars_generate_with_token_urlsafe_48
SIGNING_SECRET_ENCRYPTION_KEY=CHANGE_ME_valid_fernet_key_generate_with_Fernet_generate_key
API_KEY_PEPPER=CHANGE_ME_min_16_chars
METRICS_API_KEY=CHANGE_ME_min_16_chars
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_USER=postgres
POSTGRES_DB=webhook_platform
# Authenticated broker URL (password required in prod):
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Ingress / allowlist ---
ALLOWED_RECEIVER_DOMAINS=hooks.example.com,api.partner.com
# DEPLOY WARNING: keep False in production. The ONLY bypass
# (ALLOW_LOCAL_RECEIVERS=True + I_UNDERSTAND_ALLOW_LOCAL_RISK=1) re-opens
# loopback SSRF and must NEVER be copied into a prod .env or CI/CD secrets,
# even during a rushed incident deploy. Closed demos only.
ALLOW_LOCAL_RECEIVERS=False
USE_DEMO_RETRY_POLICY=False
PUBLIC_BASE_URL=https://hooks.example.com

# --- Email (password-reset OTPs + team invitations) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Hookflow
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# --- Tuning for small ARM VM (1 OCPU/6GB: CONCURRENCY=2; 4 OCPU/24GB: 4-8) ---
CELERY_CONCURRENCY=2
DISPATCH_MAX_WORKERS=4
DATA_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
HTTP_CONNECT_TIMEOUT_SECONDS=3.0
LOG_LEVEL=INFO
# Narrow proxy trust (prefixlen >= 16; 10.0.0.0/8 is rejected in prod).
# Set to your actual docker bridge / nginx IP, e.g. 172.18.0.0/24.
TRUSTED_PROXIES=127.0.0.1,::1,172.18.0.0/24,10.0.0.0/24
FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.18.0.0/24,10.0.0.0/24
USE_CELERY=True
ENABLE_INPROCESS_DISPATCHER=False
# Closed by default — prod overlay hardcodes False and validator enforces it.
ALLOW_OPEN_REGISTRATION=False
# Compliance hold (optional): comma-separated project IDs excluded from purge.
LEGAL_HOLD_PROJECT_IDS=
# Docker Secrets alternative: set *_FILE instead of plaintext (see app/config.py).
# SECRET_KEY_FILE=/run/secrets/secret_key
