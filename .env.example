# Application Environment
ENV=development
DEBUG=True

# Database (Supports SQLite or PostgreSQL)
# Local SQLite default:
DATABASE_URL=sqlite:///./webhooks.db
# Or PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/webhook_platform

# Secret Keys
SECRET_KEY=wh_dev_insecure_secret_key_change_in_production_1234567890
# 32 url-safe base64-encoded bytes for Fernet encryption of endpoint secrets:
SIGNING_SECRET_ENCRYPTION_KEY=yFz8s0v81v3G-xG3hV48V7s9uY5pL0tM2wN4bQ6rE8A=

# Worker & Broker
REDIS_URL=redis://localhost:6379/0

# SSRF Protection: Set to True in dev so http://127.0.0.1:8001/webhook works
ALLOW_LOCAL_RECEIVERS=True

# Retries & Delays
MAX_DELIVERY_ATTEMPTS=5
USE_DEMO_RETRY_POLICY=True
HTTP_TIMEOUT_SECONDS=10.0
LEASE_DURATION_SECONDS=30
